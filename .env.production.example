# Production configuration for compose.production.yaml.
#   cp .env.production.example .env.production   (lalu isi, JANGAN di-commit)
# Semua nilai rahasia sengaja kosong. Buat kunci BARU khusus production,
# jangan pakai ulang kunci sandbox atau kunci yang pernah dibagikan.

APP_NAME=Zetago
# php artisan key:generate --show (di container mana pun), tempel hasilnya di sini.
APP_KEY=
APP_URL=https://zetago.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# APP_ENV=production dan APP_DEBUG=false sudah ditetapkan di image.

# Port HTTP di server; reverse proxy HTTPS meneruskan ke sini.
# Proxy di server yang sama: 127.0.0.1:8080, supaya port ini tidak bisa
# diakses langsung dari internet (melewati proxy).
APP_PORT=127.0.0.1:8080

# Alamat proxy HTTPS yang boleh mengirim X-Forwarded-For/-Proto, dipisah
# koma, boleh CIDR. Contoh: proxy di host yang sama lewat jaringan Docker
# = 172.16.0.0/12; Cloudflare = daftar IP di cloudflare.com/ips.
# Kosong = tidak percaya siapa pun (semua pengunjung terlihat ber-IP proxy).
# Jangan isi * kecuali port app benar-benar hanya bisa dicapai lewat proxy:
# dengan *, siapa pun bisa mengaku ber-IP apa pun dan lolos dari throttle.
TRUSTED_PROXIES=

LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=zetago
DB_USERNAME=zetago
# openssl rand -base64 32
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Cookie sesi hanya lewat HTTPS.
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# openssl rand -base64 32
REDIS_PASSWORD=

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Penyedia email sungguhan (SMTP dari layanan email Anda).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@zetago.example.com"
MAIL_FROM_NAME="${APP_NAME}"

RAJAONGKIR_API_KEY=
RAJAONGKIR_COURIERS=jne:sicepat:jnt:pos

# Kunci PRODUCTION dari https://dashboard.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=true

MARKETPLACE_COMMISSION_BPS=500

CSP_ENABLED=true
CSP_REPORT_ONLY=false
ADMIN_REQUIRE_2FA=true
WRITES_PER_MINUTE=60

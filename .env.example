APP_NAME=Zetago
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ecommerce.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ongkir & daftar wilayah (Komerce RajaOngkir). Daftar di https://collaborator.komerce.id
RAJAONGKIR_API_KEY= EWCa6eJ976212b0a93b845a4dLha0Bj3
RAJAONGKIR_COURIERS=jne:sicepat:jnt:pos

# Pembayaran (Midtrans). Sandbox: https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

# Komisi Zetago dari harga barang, dalam basis poin (500 = 5%)
MARKETPLACE_COMMISSION_BPS=500

# Content-Security-Policy (lihat config/security.php)
CSP_ENABLED=true

# Content-Security-Policy (lihat config/security.php)
CSP_REPORT_ONLY=false

# Halaman admin wajib 2FA/passkey (matikan hanya untuk eksperimen lokal)
ADMIN_REQUIRE_2FA=true
# Batas request tulis (POST/PUT/DELETE) per menit per pengguna
WRITES_PER_MINUTE=60
